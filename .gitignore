# Ansible Vault password-fil: aldrig i Git, ellers er krypteringen meningsløs
.vault_pass

# Kundespecifikke inventory-filer: IP og stier hører ikke i et delt repo.
# Vi committer i stedet en hosts.yml.example som skabelon (se nedenfor).
inventories/*/hosts.yml

# Private SSH-nøgler: fang dem hvis de nogensinde lander i projektmappen
*.pem
*.key

# Ansible-støj
*.retry

# Python-cache
__pycache__/
*.pyc

# Editor-filer
.vscode/
*.swp

# Miljøfiler med secrets: fang dem hvis de lander i projektmappen
**/.env

# Ansible Vault-krypterede variabler: ignorér den ukrypterede version
# Commit kun efter: ansible-vault encrypt group_vars/all/vault.yml
group_vars/all/vault.yml

# Kundespecifik konfiguration: aldrig i Git — indeholder domæne og e-mail
group_vars/all/config.yml