server {
    listen 80;
    server_name {% for sub in nginx_subdomains %}{{ sub }}.{{ nginx_domain }}{% if not loop.last %} {% endif %}{% endfor %};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 200 'Bootstrap mode';
        add_header Content-Type text/plain;
    }
}
