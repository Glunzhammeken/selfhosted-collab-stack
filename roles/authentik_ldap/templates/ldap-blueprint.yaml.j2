version: 1
metadata:
  name: ldap-setup
  labels:
    blueprints.goauthentik.io/description: "LDAP provider, outpost og service account"
entries:
  # Role skal oprettes FØR brugeren, så !KeyOf kan opløses.
  # search_full_directory tildeles globalt på rollen (per-entry permissions:
  # på provideren fejlede med "For global permissions" — importeren scoper
  # ikke til instans). Vi har kun én LDAP-provider, så global ≡ object her.
  - model: authentik_rbac.role
    state: present
    id: role-ldap-search
    identifiers:
      name: ldap-search
    attrs:
      permissions:
        - authentik_providers_ldap.search_full_directory

  # service_account — kun oprettet én gang; adgangskode læses fra env-variabel
  - model: authentik_core.user
    state: created
    identifiers:
      username: ldapservice
    attrs:
      name: LDAP Service Account
      type: service_account
      path: users
      is_active: true
      password: !Env [AUTHENTIK_LDAP_SVC_PASS, ""]
      roles:
        - !KeyOf role-ldap-search

  # Testbrugere til verifikation af Mailcow- og Nextcloud-integration.
  # Kendt password (Andr3k012!) — kun til udvikling/test.
  - model: authentik_core.user
    state: created
    identifiers:
      username: testuser1
    attrs:
      name: Test User 1
      email: testuser1@{{ nginx_domain }}
      path: users
      is_active: true
      password: "{{ authentik_testuser_password }}"

  - model: authentik_core.user
    state: created
    identifiers:
      username: testuser2
    attrs:
      name: Test User 2
      email: testuser2@{{ nginx_domain }}
      path: users
      is_active: true
      password: "{{ authentik_testuser_password }}"

  - model: authentik_providers_ldap.ldapprovider
    state: present
    id: ldap-provider
    identifiers:
      name: ldap-provider
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      authentication_flow: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      base_dn: "{{ authentik_ldap_base_dn }}"
      # direct: hver bind valideres mod Authentik. Nødvendigt for at SOGo og
      # andre LDAP-klienter kan binde testbrugere der ikke først har logget
      # ind via Authentiks web-UI (cached kræver eksisterende cache-entry).
      bind_mode: direct
      search_mode: direct

  - model: authentik_core.application
    state: present
    identifiers:
      slug: ldap
    attrs:
      name: LDAP
      provider: !KeyOf ldap-provider
      policy_engine_mode: any

  - model: authentik_outposts.dockerserviceconnection
    state: present
    id: docker-svc-conn
    identifiers:
      name: docker-socket-proxy
    attrs:
      local: false
      url: "http://authentik-socket-proxy:2375"

  - model: authentik_outposts.outpost
    state: present
    identifiers:
      name: "{{ authentik_outpost_name }}"
    attrs:
      type: ldap
      service_connection: !KeyOf docker-svc-conn
      providers:
        - !KeyOf ldap-provider
      config:
        docker_network: proxy-net
        authentik_host: "{{ authentik_url }}"
        authentik_host_insecure: false
        docker_map_ports: true
