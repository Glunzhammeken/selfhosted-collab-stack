PG_PASS={{ pg_pass_result.stdout }}
AUTHENTIK_SECRET_KEY={{ secret_key_result.stdout }}
AUTHENTIK_BOOTSTRAP_TOKEN={{ _bootstrap_token }}
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_DISABLE_STARTUP_ANALYTICS=true
AUTHENTIK_AVATARS=none
AUTHENTIK_COOKIE_DOMAIN=.{{ nginx_domain }}
COMPOSE_PORT_HTTP=127.0.0.1:9000
COMPOSE_PORT_HTTPS=127.0.0.1:9443
